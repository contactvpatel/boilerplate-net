<Project>
  <!-- Unit test project only: use .runsettings to exclude integration tests when running that project alone. -->
  <!-- IntegrationTests project does not use this, so "dotnet test" runs both unit and integration tests. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WebShop.UnitTests'">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Language & Framework -->
    <TargetFramework>net10.0</TargetFramework>    
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code Quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Security -->
    <EnablePackageVulnerabilityAudit>true</EnablePackageVulnerabilityAudit>

    <!-- Deterministic Builds -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>