<?xml version="1.0" encoding="utf-8"?>
<!--
  Code Coverage Configuration
  Based on: docs/testing-strategy.md
  
  This file configures what code is included/excluded from coverage reports.
  Reference: docs/testing-strategy.md for detailed explanation of what should be tested.
  
  Excludes integration tests (they share DB; run via pwsh scripts/run-tests.ps1 -TestType Integration).
-->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category!=Integration</TestCaseFilter>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          
          <!--
            WHAT IS INCLUDED IN COVERAGE:
            ✅ Business Logic (Business Services, Repositories)
            ✅ Public API Contracts (Controllers, Service interfaces, Repository methods)
            ✅ Error Handling (Exception scenarios, null handling)
            ✅ Data Access Logic (Query filters, complex queries, transactions)
            ✅ Integration Points (External services, cache, middleware, filters)
            
            Only code in ../src directory is included (test projects excluded automatically).
          -->
          
          <!--
            EXCLUDE: Test Projects
            Per testing-strategy.md: Test projects should not be included in coverage metrics.
          -->
          <Exclude>[*.Tests]*,[*.Test]*,[*UnitTests]*,[*IntegrationTests]*</Exclude>
          
          <!--
            EXCLUDE: Generated Code and Obsolete Code
            Per testing-strategy.md Section "3. Generated Code":
            - Database migrations (generated by EF Core)
            - Compiler-generated code
            - Code with [GeneratedCode] attribute
            - Obsolete code
          -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          
          <!--
            EXCLUDE: Files and Directories
            Per testing-strategy.md:

            1. Generated Code (Section "3. Generated Code")
               - **/DbUp/** - Database migration scripts (in Infrastructure layer)
               - **/Migrations/** - EF Core migrations

            2. Configuration and Startup Code (Section "6. Configuration and Startup Code")
               - **/Program.cs - Application startup code
               - **/DependencyInjection.cs - Dependency injection setup
               - **/Startup.cs - Application startup code

            3. Simple Property Accessors (Section "2. Simple Property Accessors")
               - **/*Dto.cs - DTOs with only properties (trivial code)
               - **/WebShop.Api/Models/** - API models (simple property accessors)
               - **/WebShop.Business/DTOs/** - Business DTOs (simple property accessors)

            4. Framework Extensions and Helpers (Section "1. Framework Code")
               - **/Extensions/** - All extension methods (configuration/wiring)
               - **/Helpers/OpenApiTransformer.cs - Framework helpers

            5. Hosted Services and Startup (Section "6. Configuration")
               - **/HostedServices/** - Hosted services (integration-level)
               - **/Helpers/HealthCheckResponseWriter.cs - Health check wiring

            6. Mapping Configuration and Infrastructure (Section "6. Configuration")
               - **/Mappings/** - Mapster/mapping configuration (wiring)
               - **/Helpers/DapperQueryBuilder.cs - Internal query builder (integration-level)
               - **/Helpers/DapperTransactionManager.cs - Transaction handling (integration-level)
               - **/UnitOfWork.cs - Unit of work orchestration (integration-level)
               - **/CacheOptions.cs - Options model (no logic)
               - **/DbConnectionStringCache.cs - Internal cache (integration-level)

            7. Authorization Framework Adapters (Section "1. Framework Code")
               - **/AsmAuthorization*.cs - ASM authorization handlers (framework adapters)
               - **/AsmErrorResponseFactory.cs - ASM error response (framework adapter)
               - **/AsmPermissionMapper.cs - ASM permission mapping (framework adapter)
               - **/AsmPermissionValidator.cs - ASM permission validation (framework adapter)
               - **/PermissionRequirement.cs - Authorization requirement (framework)
               - **/CorrelationIdMiddleware.cs - Correlation ID (infrastructure wiring)

            8. Repository Layer (tested via integration tests with real database)
               - **/Repositories/** - Repository implementations (integration-tested)

            9. External Service Proxies (integration-tested via API)
               - **/HttpServiceBase.cs - HTTP client base
               - **/Services/External/MisService.cs - MIS external service proxy

            10. Infrastructure helpers not exercised by API integration tests
               - **/UrlValidator.cs,**/HttpErrorHandler.cs,**/DatabaseConnectionValidator.cs

            11. Auth/SSO code (tested via dedicated auth tests; integration tests use unauthenticated client)
               - **/CacheKeys.cs,**/JwtTokenHelper.cs,**/ConfigurationKeys.cs,**/DbConnectionModel.cs
               - **/SsoController.cs,**/MisController.cs,**/AsmController.cs - require auth
               - **/SsoService.cs,**/MisService.cs,**/AsmService.cs - used by excluded controllers
               - **/JwtTokenAuthenticationFilter.cs - requires JWT auth

            12. Exception handling strategy only (middleware itself IS unit-tested → included in coverage)
               - **/ExceptionHandlingStrategy.cs - strategy config; middleware in ExceptionHandlingMiddleware.cs is included

            13. External HTTP / auth infrastructure with no unit tests
               - (HttpClientExtensions, SensitiveDataSanitizer, UserContext are unit-tested → included in coverage)

            Note: Framework code (ASP.NET Core, EF Core internals) cannot be easily excluded
            via file patterns but is documented as excluded per testing-strategy.md Section "1. Framework Code".
          -->
          <ExcludeByFile>**/DbUp/**,**/Migrations/**,**/Program.cs,**/DependencyInjection.cs,**/Startup.cs,**/*Dto.cs,**/WebShop.Api/Models/**,**/WebShop.Business/DTOs/**,**/Extensions/**,**/Helpers/OpenApiTransformer.cs,**/HostedServices/**,**/Helpers/HealthCheckResponseWriter.cs,**/Mappings/**,**/DapperQueryBuilder.cs,**/DapperTransactionManager.cs,**/UnitOfWork.cs,**/CacheOptions.cs,**/DbConnectionStringCache.cs,**/AsmAuthorization*.cs,**/AsmErrorResponseFactory.cs,**/AsmPermissionMapper.cs,**/AsmPermissionValidator.cs,**/PermissionRequirement.cs,**/CorrelationIdMiddleware.cs,**/Repositories/**,**/HttpServiceBase.cs,**/Services/External/MisService.cs,**/UrlValidator.cs,**/HttpErrorHandler.cs,**/DatabaseConnectionValidator.cs,**/CacheKeys.cs,**/JwtTokenHelper.cs,**/ConfigurationKeys.cs,**/DbConnectionModel.cs,**/SsoController.cs,**/MisController.cs,**/AsmController.cs,**/SsoService.cs,**/MisService.cs,**/AsmService.cs,**/JwtTokenAuthenticationFilter.cs,**/ExceptionHandlingStrategy.cs,**/obj/**,**/*.g.cs,**/*.generated.cs</ExcludeByFile>
          
          <!--
            INCLUDE: Only Source Code Directory
            Per testing-strategy.md Section "Code Coverage Configuration":
            Only include code from the ../src directory (excludes test projects automatically).
          -->
          <IncludeDirectory>../src</IncludeDirectory>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
